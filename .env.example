# API Keys
# OpenAI API key (rename to OPENAI_API_KEY recommended)
OPENAI_API_KEY=your_openai_api_key

# Resend (email) API key
RESEND_API_KEY=your_resend_api_key

# MySQL / Database settings
MYSQLHOST=localhost
MYSQLUSER=your_db_user
MYSQLPASSWORD=your_db_password
MYSQLDATABASE=your_db_name
MYSQLPORT=3306

# NOTE: Some environments use underscored names (e.g. MYSQL_DATABASE). The app
# accepts either `MYSQLDATABASE` or `MYSQL_DATABASE` for compatibility.
# You can optionally set `MYSQL_DATABASE` if your system uses that naming.
# Example:
# MYSQL_DATABASE=your_db_name

# NOTE: Never commit real secrets. Use this file only as a template.

# Session
SESSION_SECRET=your_session_secret

# Database Configuration
MYSQLDATABASE=your_database_name
MYSQLHOST=localhost
MYSQLPORT=3307
MYSQLUSER=your_username
MYSQLPASSWORD=your_password

# Environment
NODE_ENV=development